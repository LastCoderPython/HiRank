{
    order rate_limit before basicauth
}

:80 {
    respond /docs* 403
    respond /redoc* 403
    respond /openapi.json 403

    handle /api/v1/health* {
        reverse_proxy {$API_UPSTREAM:api:9000}
    }

    handle /api/* {
        rate_limit {
            zone api_limit {
                key {http.request.header.X-Forwarded-For}
                events 20
                window 2s
            }
        }
        reverse_proxy {$API_UPSTREAM:api:9000} {
            flush_interval -1
        }
    }

    handle {
        respond 404
    }
}
