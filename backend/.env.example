# .env.example

# ── SECURITY WARNING ──────────────────────────────────────────────────
# DO NOT commit the real .env file to version control. API keys in .env
# are in plaintext. For production, use Docker secrets or a secrets
# manager (e.g. HashiCorp Vault, AWS Secrets Manager).
# See SETUP.md for production security recommendations.
# ──────────────────────────────────────────────────────────────────────

# LLM Provider
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
PRIMARY_MODEL=llama-3.3-70b-versatile
FALLBACK_MODEL_1=llama-3.1-8b-instant
FALLBACK_MODEL_2=llama-3.1-8b-instant

# WARNING: Set to false in production to avoid leaking stack traces
DEBUG=false
CORS_ORIGINS=http://localhost:3000

# Embedding
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector Database
VECTOR_DB=chroma
CHROMA_PERSIST_DIR=./data/chroma
# ChromaDB Server (Client/Server mode — used by Docker Compose & Azure)
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_AUTH_TOKEN=changeme-generate-with-openssl-rand-hex-32

# Data CSV Paths
CEE_DATA_PATH=./data/cee_cutoffs.csv
JEE_DATA_PATH=./data/jee_cutoffs.csv

# Supabase (Auth + Database)
SUPABASE_URL=https://your-project-ref.supabase.co/rest/v1/
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Frontend URL (OAuth redirect)
FRONTEND_URL=http://localhost:3000

# Agent API
AGENT_API_KEYS=local-dev-key
AGENT_RATE_LIMIT_PER_MINUTE=120

# Redis (Celery broker + result backend)
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_PASSWORD=changeme-in-production

# LangSmith (observability — consumed by langsmith library, not config.py)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=rankroute-production
LANGSMITH_API_KEY=your_langsmith_api_key_here

# Tavily (Live Web Search Fallback)
TAVILY_API_KEY="your_tavily_api_key_here"
TAVILY_MAX_RESULTS=5
FALLBACK_ENABLED=true
OFFICIAL_DOMAIN_SUFFIXES=.ac.in,.edu.in,.gov.in,.nic.in

# Freemium Usage Limits
ANON_PROMPT_LIMIT=3
ANON_TAVILY_LIMIT=1
AUTH_TAVILY_MONTHLY_LIMIT=5
TAVILY_MONTHLY_QUOTA=1000

# Flower (Celery Monitoring — optional)
FLOWER_PASSWORD=changeme-in-production
